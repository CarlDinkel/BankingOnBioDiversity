logit treated $pscore_core if pscore_sample == 1, vce(robust)

margins, dydx(*) post
estimates store logit_mfx


* check propensity-score overlap (logit)

summ ps_logit if treated == 1 & pscore_sample == 1, detail
local min_t = r(min)
local max_t = r(max)

gen in_support = ps_logit >= `min_t' & ps_logit <= `max_t' if pscore_sample == 1

tab treated in_support if pscore_sample == 1
summ ps_logit if treated == 1 & pscore_sample == 1, detail
summ ps_logit if treated == 0 & pscore_sample == 1, detail
summ ps_logit if treated == 0 & in_support == 1, detail

