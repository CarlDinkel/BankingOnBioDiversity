// Recode GAEZ suitability classes to approximate SI score

function recodeSuitability(img) {
  var bands = img.bandNames();

  var recodedBands = bands.map(function(b) {
    b = ee.String(b);

    var x = img.select(b);

    var masked = x.updateMask(x.neq(9));

    var recoded = masked
      .where(masked.eq(1), 92.5)
      .where(masked.eq(2), 77.5)
      .where(masked.eq(3), 62.5)
      .where(masked.eq(4), 47.5)
      .where(masked.eq(5), 32.5)
      .where(masked.eq(6), 17.5)
      .where(masked.eq(7), 5)
      .where(masked.eq(8), 0)
      .rename(b.cat("_meanSI"));

    return recoded;
  });

  return ee.ImageCollection.fromImages(recodedBands).toBands()
    .rename(bands.map(function(b) {
      return ee.String(b).cat("_meanSI");
    }));
}

var gaezSI = recodeSuitability(gaez);


var suitabilityByBuffer = gaezSI.reduceRegions({
  collection: treatment,
  reducer: ee.Reducer.mean(),
  scale: 1000,
  crs: gaez.projection(),
  tileScale: 4
});


Export.table.toDrive({
  collection: suitabilityByBuffer,
  description: "GAEZ_crop_suitability_meanSI_30km_Rainfed_lowinput_CSB",
